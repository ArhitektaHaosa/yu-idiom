APP_NAME=yu-idiom
APP_ENV=production
APP_URL=https://example.com
APP_KEY=change-me-to-32-random-bytes

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yu_idiom
DB_USER=yu_idiom
DB_PASS=

ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Optional localhost OPUS-MT. Leave empty to disable.
OPUSMT_URL=http://127.0.0.1:8091
OPUSMT_TIMEOUT=8

EXTERNAL_TRANSLATE_ENABLED=0
EXTERNAL_TRANSLATE_URL=
EXTERNAL_TRANSLATE_KEY=

SESSION_NAME=yuidiom
COOKIE_SECURE=1
COOKIE_SAMESITE=Lax

RATE_LIMIT_TRANSLATE_PER_MIN=30
RATE_LIMIT_SEARCH_PER_MIN=60
